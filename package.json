{
  "name": "edu_abstract_datatype_visualizer",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm ci --prefix upstream --no-audit --no-fund",
    "dev": "cd upstream && node node_modules/vite/bin/vite.js --config vite.config-visualizer.ts --host 0.0.0.0",
    "build": "cd upstream && node --max-old-space-size=6144 node_modules/vite/bin/vite.js build --config vite.config-visualizer.ts",
    "test": "cd upstream && node node_modules/vitest/vitest.mjs run src/visualizer/visualizer.test.ts",
    "test:browser": "cd upstream && node browser-test.mjs",
    "test:editor": "cd upstream && node editor-browser-test.mjs",
    "typecheck": "cd upstream && node node_modules/typescript/bin/tsc --noEmit",
    "build:pages": "npm run build && node scripts/package-pages.mjs",
    "test:pages": "node upstream/pages-smoke.mjs"
  }
}
